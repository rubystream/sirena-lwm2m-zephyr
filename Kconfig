	int "Maximum number of object instances"
	default 16
	range 1 1024

config SIRENA_LWM2M_MAX_RESOURCES_PER_INSTANCE
	int "Maximum number of resources per instance"
	default 16
	range 1 256

config SIRENA_LWM2M_CODEC_MAX_VALUE_SIZE
	int "Maximum codec value size"
	default 64
	range 1 4096

config SIRENA_LWM2M_CODEC_MAX_VALUES
	int "Maximum codec values per call"
	default 8
	range 1 64

