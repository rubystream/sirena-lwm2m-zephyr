config SIRENA_LWM2M_MAX_OBJECTS
	int "Maximum number of registered objects"
	default 8
	range 1 256

config SIRENA_LWM2M_MAX_INSTANCES
	int "Maximum number of object instances"
	default 16
	range 1 1024

config SIRENA_LWM2M_MAX_RESOURCES_PER_INSTANCE
	int "Maximum number of resources per instance"
	default 25 if SIRENA_LWM2M_OBJECT_SECURITY_OPTIONAL || SIRENA_LWM2M_OBJECT_DEVICE_OPTIONAL
	default 16
	range 1 256

config SIRENA_LWM2M_CODEC_MAX_VALUE_SIZE
	int "Maximum codec value size"
	default 64
	range 1 4096

config SIRENA_LWM2M_CODEC_MAX_VALUES
	int "Maximum codec values per call"
	default 8
	range 1 64

menu "Sirena LwM2M"

config SIRENA_LWM2M
	bool "Enable Sirena LwM2M client core"
	default y

if SIRENA_LWM2M

config SIRENA_LWM2M_OBJECT_SECURITY_OPTIONAL
	bool "Enable optional Security object (0) resources"
	default n

config SIRENA_LWM2M_OBJECT_SERVER_OPTIONAL
	bool "Enable optional Server object (1) resources"
	default n

config SIRENA_LWM2M_OBJECT_DEVICE_OPTIONAL
	bool "Enable optional Device object (3) resources"
	default n

config SIRENA_LWM2M_SERVER_URI_MAX
	int "Maximum length of the LwM2M server URI"
	default 64
	range 16 512

config SIRENA_LWM2M_CREDENTIAL_MAX
	int "Maximum size of a credential (identity, public key, secret key)"
	default 128 if SIRENA_LWM2M_TRANSPORT_DTLS
	default 32
	range 8 1024
	help
	  The Security object stores the identity, the public key and the
	  secret key in buffers of this size. The DTLS binding needs room
	  for the PSK identity and the PSK key, so the size is raised when
	  the DTLS binding is enabled.

config SIRENA_LWM2M_SERVER_STRING_MAX
	int "Maximum length of a server side string (binding, optional strings)"
	default 32
	range 8 512

config SIRENA_LWM2M_DEVICE_STRING_MAX
	int "Maximum length of a device metadata string"
	default 32
	range 8 512

config SIRENA_LWM2M_ENGINE_QUEUE_SIZE
	int "Maximum number of queued engine requests"
	default 8
	range 1 64

config SIRENA_LWM2M_ENGINE_STACK_SIZE
	int "Engine thread stack size in bytes"
	default 2048
	range 512 16384

config SIRENA_LWM2M_ENGINE_PRIORITY
	int "Engine thread priority"
	default 5
	range -32 32

config SIRENA_LWM2M_ENDPOINT_NAME_MAX
	int "Maximum length of the LwM2M endpoint client name"
	default 32
	range 8 128
	help
	  The endpoint client name is carried in a CoAP URI-Query option, so
	  CONFIG_COAP_EXTENDED_OPTIONS_LEN_VALUE has to hold the name and
	  the "ep=" prefix.

config SIRENA_LWM2M_LOCATION_PATH_MAX
	int "Maximum length of the stored registration location path"
	default 64
	range 16 256

config SIRENA_LWM2M_REGISTRATION_PAYLOAD_MAX
	int "Maximum length of the registration link-format payload"
	default 256
	range 32 1024

config SIRENA_LWM2M_COAP_RESPONSE_TIMEOUT_MS
	int "CoAP response timeout in milliseconds"
	default 10000
	range 100 60000

config SIRENA_LWM2M_TRANSPORT_COAP
	bool "Enable the CoAP/UDP transport binding"
	default y
	depends on COAP && COAP_CLIENT
	select COAP_EXTENDED_OPTIONS_LEN
	help
	  Enables the plain CoAP over UDP transport binding. The binding
	  registers with the LwM2M server, updates the registration and
	  deregisters. DTLS, observation and read, write and execute are not
	  part of this binding.

config SIRENA_LWM2M_TRANSPORT_DTLS
	bool "Enable the CoAP/DTLS transport binding"
	default y
	depends on COAP && COAP_CLIENT && NET_SOCKETS && MBEDTLS && NET_SOCKETS_SOCKOPT_TLS
	select COAP_EXTENDED_OPTIONS_LEN
	select NET_SOCKETS_ENABLE_DTLS
	select PSA_WANT_ALG_HMAC
	select PSA_WANT_ALG_SHA_384
	select MBEDTLS_SSL_PROTO_TLS1_2
	select MBEDTLS_SSL_PROTO_DTLS
	select MBEDTLS_KEY_EXCHANGE_PSK_ENABLED
	select PSA_WANT_ALG_CCM
	select PSA_WANT_ALG_SHA_256
	select PSA_WANT_ALG_TLS12_PRF
	select PSA_WANT_ALG_TLS12_PSK_TO_MS
	select PSA_WANT_KEY_TYPE_AES
	select PSA_WANT_KEY_TYPE_DERIVE
	help
	  Enables the secure CoAP over DTLS transport binding. The binding
	  reads the pre-shared key credentials from the Security object and
	  registers with the LwM2M server over DTLS 1.2 with the
	  TLS_PSK_WITH_AES_128_CCM_8 ciphersuite. It needs mbed TLS with the
	  PSK key exchange enabled, so the application has to enable
	  CONFIG_MBEDTLS and CONFIG_NET_SOCKETS_SOCKOPT_TLS.

	  The binding selects the HMAC and the SHA-384 algorithms of mbed
	  TLS. The TLS 1.2 master secret is 48 bytes long and the static
	  PSA key slots are sized by the largest hash of the build, so the
	  master secret only fits into a key slot when HMAC and SHA-384 are
	  enabled. An application that enables the mbed TLS heap instead
	  does not need them for the key slot size.

config SIRENA_LWM2M_TRANSPORT_NOSEC
	bool "Allow the NoSec security mode"
	default n
	help
	  Allows the client to talk to a server that uses the NoSec security
	  mode, which means that the traffic is not protected at all. The
	  switch is off by default, so a production build cannot silently
	  talk to a server in the clear. It is meant for development and
	  testing only and it has no effect on the DTLS binding.

config SIRENA_LWM2M_PSK_IDENTITY_MAX
	int "Maximum size of the DTLS PSK identity"
	default 128
	range 1 128
	depends on SIRENA_LWM2M_TRANSPORT_DTLS
	help
	  The OMA LwM2M 1.2 Transport Bindings specification requires support
	  for PSK identities of up to 128 bytes.

config SIRENA_LWM2M_PSK_KEY_MAX
	int "Maximum size of the DTLS PSK key"
	default 64
	range 1 64
	depends on SIRENA_LWM2M_TRANSPORT_DTLS
	help
	  The OMA LwM2M 1.2 Transport Bindings specification requires support
	  for PSK keys of up to 64 bytes. mbed TLS limits the key size with
	  CONFIG_MBEDTLS_PSK_MAX_LEN, which has to be raised to the same
	  size to use a key of more than 32 bytes.

if SIRENA_LWM2M_TRANSPORT_COAP || SIRENA_LWM2M_TRANSPORT_DTLS

config COAP_EXTENDED_OPTIONS_LEN_VALUE
	int "CoAP extended options length value"
	default 64
	depends on COAP_EXTENDED_OPTIONS_LEN
	help
	  The registration carries the endpoint client name in a URI-Query
	  option. The value has to hold that option, so it is sized for the
	  endpoint client name limit and the "ep=" prefix.

config SIRENA_LWM2M_COAP_LOCATION_SEGMENTS
	int "Maximum number of Location-Path segments in a registration response"
	default 4
	range 1 16

config SIRENA_LWM2M_COAP_PATH_MAX
	int "Maximum length of a CoAP request path"
	default 128
	range 32 256

endif

endif

endmenu
